# Credenciais do Supabase (Dashboard -> Settings -> API)
SUPABASE_URL=sua_url_aqui
SUPABASE_KEY=sua_service_role_key_aqui

# Número administrativo (formato 55DDD9XXXXXXXX) — opcional para comandos "/"
OWNER_NUMBER=55DDD9XXXXXXXX

# Número público do bot no WhatsApp usado nos QR Codes da página /testar (opcional se já pareado no Baileys)
BOT_WHATSAPP_NUMBER=55DDD9XXXXXXXX

# Token secreto para proteger a rota de pareamento /qr?token=...
QR_TOKEN=crie_um_token_secreto_aqui

# Provedores de IA em rodízio gratuito / failover (src/services/provedores.js)
# Groq: groq.com (Whisper para áudio + LLMs) | Gemini: aistudio.google.com (visão de fotos e linguagem)
GROQ_API_KEY=
GEMINI_API_KEY=

# Provedores extras opcionais para failover automático (também aceitam sufixos _2.._20)
# CEREBRAS_API_KEY=
# GITHUB_TOKEN=
# MISTRAL_API_KEY=
# OPENROUTER_API_KEY=
# SAMBANOVA_API_KEY=
# NVIDIA_API_KEY=

# Busca de insumos (opcional — fallback usa links construídos sem chave)
# BRAVE_API_KEY=

# Porta HTTP do servidor Express (/testar, /rotacao, /ping, /qr)
# PORT=3000
